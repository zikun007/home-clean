: 1791439368:0;python3 - <<'PY'\
import copy\
import json\
from pathlib import Path\
\
catalog_path = Path.home() / ".codex" / "horizon_model_catalog.json"\
model_specs = [\
    ("HORIZON-OG-Astra", 1),\
    ("HORIZON-OG-Sol", 2),\
    ("HORIZON-OG-Luna", 3),\
    ("HORIZON-DeepSeek-Pro", 4),\
    ("HORIZON-GLM", 5),\
    ("HORIZON-KIMI", 6),\
    ("HORIZON-MiniMax", 7),\
]\
\
catalog = json.loads(catalog_path.read_text())\
template = catalog["models"][0]\
models = []\
for slug, priority in model_specs:\
    model = copy.deepcopy(template)\
    model["slug"] = slug\
    model["display_name"] = slug\
    model["priority"] = priority\
    models.append(model)\
\
catalog["models"] = models\
catalog_path.write_text(json.dumps(catalog, ensure_ascii=False, indent=2) + "\n")\
print(f"wrote {len(models)} models to {catalog_path}")\
PY
