.DS_Store
*.log
*.history

# pi agent 运行时产物（含 API Key 与会话数据，不入库）
.pi/agent/auth.json
.pi/agent/mcp-auth.json
.pi/agent/models-store.json
.pi/agent/sessions/

.config/zsh/.zsh_sessions
.config/zsh/.zcompdump*

.cache/*
.local/state/*.log

# .local/share 仅维护 zsh 历史与字体；其余为运行时文件，不入库
.local/share/*
!.local/share/zsh/
!.local/share/fonts/
.local/share/recently-used.xbel

# 运行时生成的编译缓存与 fontconfig 标识
*.zwc
.config/fonts/.uuid
