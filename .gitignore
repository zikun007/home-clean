.DS_Store
*.log
*.history

# .agents/lark-bot 运行时产物（配置含 open_id，状态/日志/记忆不入库）
.agents/lark-bot/config.env
.agents/lark-bot/state.db
.agents/lark-bot/state.db-*
.agents/lark-bot/logs/
.agents/lark-bot/memory/
.agents/lark-bot/*.pid
.agents/lark-bot/last_message_*.txt
.agents/lark-bot/events.ndjson
.agents/lark-bot/__pycache__/
.agents/lark-bot/**/__pycache__/
*.pyc

.config/zsh/.zsh_sessions
.local/share/zsh/.zsh_history
.local/share/zsh/.zsh_sessions/
.config/zsh/.zcompdump*

.cache/*
.local/state/*.log

# .local/share 仅维护字体；其余为运行时文件，不入库
.local/share/*
!.local/share/zsh/
!.local/share/fonts/
.local/share/recently-used.xbel

# 运行时生成的编译缓存与 fontconfig 标识
*.zwc
.config/fonts/.uuid
