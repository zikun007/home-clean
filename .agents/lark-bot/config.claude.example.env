# lark-bot 运行时配置模板（Claude Code 版本）
# 复制到 ~/.claude/lark-bot/config.env 并 chmod 600。
# 该文件含个人 open_id，不要提交到仓库。
#
# 注意：飞书事件总线按 appId 隔离，同一个 app 只允许一个消费者。
# Claude 实例需要独立的飞书 app / lark-cli profile（claude），
# 不能和 codex / omp 共用同一个 app。

# 主人 open_id（Claude 这个飞书 app 下的 open_id）
OWNER_ID=ou_xxxxxxxxxxxxxxxx

# 工作区（支持 ~ 展开）
WORKDIR=~/Workspace

# 助手类型与可执行文件
AGENT_KIND=claude
AGENT_BIN=
CLAUDE_BIN=claude
AGENT_MODEL=

# Claude 非交互权限：acceptEdits | auto | bypassPermissions | manual | dontAsk | plan
# 机器人需要联网搜索、下载素材、写笔记，推荐 bypassPermissions。
CLAUDE_PERMISSION_MODE=bypassPermissions

# lark-cli 与 profile（Claude 实例自己的 app）
LARK_CLI_BIN=lark-cli
LARK_PROFILE=claude

MAX_CONCURRENCY=1
TASK_TIMEOUT=7200

# 群聊：off | owner | mention | all
GROUP_MODE=off
BOT_OPEN_ID=
ALLOWED_CHATS=

# 会话粒度：chat | thread
SESSION_SCOPE=chat

PROGRESS=1
PROGRESS_BATCH_ITEMS=10
PROGRESS_BATCH_SECONDS=60
QUIET=0
# 监听卡片按钮事件；未订阅 card.action.trigger 时仍可用 /answer
CARD_ACTIONS=1

REPLY_FORMAT=markdown
MAX_REPLY_BYTES=3500

LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# 论文推送（所有 lark-bot 实例共用 PAPER_HOME，同一天只推一次）
# ---------------------------------------------------------------------------
PAPER_HOME=~/.agents/papers
PAPER_ENABLED_DEFAULT=0
PAPER_TOPICS_FILE=
PAPER_PUSH_TIME=08:30
PAPER_TIMEZONE=
PAPER_MIN=4
PAPER_MAX=8
PAPER_LOOKBACK_HOURS=96
PAPER_MAX_RESULTS_PER_CATEGORY=50
PAPER_CATEGORY_LIMIT=3
PAPER_MAX_ATTACH=3
# 创建飞书文档需要用本实例自己的用户身份（claude）
PAPER_DOC_PROFILE=claude
PAPER_DOC_FOLDER=
PAPER_NOTE_UPLOAD=1
PAPER_S2_API_KEY=
PAPER_HF_ENABLED=0
