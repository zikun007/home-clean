#!/usr/bin/env bash
# lark-bot 运行控制脚本
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    SOURCE_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    case "$SOURCE" in
        /*) ;;
        *) SOURCE="$SOURCE_DIR/$SOURCE" ;;
    esac
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
BOT_SRC="$(cd "$SCRIPT_DIR/.." && pwd)"
BOT_HOME="${LARK_BOT_HOME:-$HOME/.agents/lark-bot}"
SERVICE_NAME="${LARK_BOT_SERVICE:-lark-bot}"
PYTHON_BIN="${PYTHON_BIN:-python3}"
PID_FILE="$BOT_HOME/bridge.pid"
CONFIG_FILE="$BOT_HOME/config.env"

usage() {
    cat <<'USAGE'
用法: lark-bot <command>

  run [--no-console]   前台运行
  start                后台启动（setsid）
  stop                 停止后台进程
  restart              重启
  status               查看任务/队列/进程状态
  check                检查配置、二进制和飞书鉴权
  logs                 跟踪日志
USAGE
}

ensure_home() {
    mkdir -p "$BOT_HOME/logs" "$BOT_HOME/memory"
    if [ ! -f "$CONFIG_FILE" ]; then
        echo "缺少配置: $CONFIG_FILE" >&2
        echo "请先复制 $BOT_SRC/config.example.env 并填写 OWNER_ID" >&2
        exit 1
    fi
    chmod 600 "$CONFIG_FILE" 2>/dev/null || true
}

pid_alive() {
    local pid="${1:-}"
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

read_pid() {
    [ -f "$PID_FILE" ] && cat "$PID_FILE" 2>/dev/null || true
}

case "${1:-}" in
    run)
        shift
        ensure_home
        exec "$PYTHON_BIN" "$BOT_SRC/bridge.py" --home "$BOT_HOME" run "$@"
        ;;
    check)
        ensure_home
        exec "$PYTHON_BIN" "$BOT_SRC/bridge.py" --home "$BOT_HOME" check
        ;;
    status)
        ensure_home
        exec "$PYTHON_BIN" "$BOT_SRC/bridge.py" --home "$BOT_HOME" status
        ;;
    start)
        ensure_home
        if command -v systemctl >/dev/null 2>&1 && systemctl --user is-active --quiet "$SERVICE_NAME" 2>/dev/null; then
            echo "systemd 服务 $SERVICE_NAME 已在运行；请使用 systemctl --user restart $SERVICE_NAME" >&2
            exit 1
        fi
        pid="$(read_pid)"
        if pid_alive "$pid"; then
            echo "已在运行 (pid=$pid)"
            exit 0
        fi
        rm -f "$PID_FILE"
        nohup setsid "$PYTHON_BIN" "$BOT_SRC/bridge.py" --home "$BOT_HOME" run --no-console \
            >>"$BOT_HOME/logs/daemon.log" 2>&1 </dev/null &
        echo $! > "$PID_FILE"
        sleep 1
        if pid_alive "$(read_pid)"; then
            echo "已启动 (pid=$(read_pid))"
            echo "日志: $BOT_HOME/logs/bridge.log"
        else
            echo "启动失败，最近日志：" >&2
            tail -n 30 "$BOT_HOME/logs/daemon.log" >&2 || true
            rm -f "$PID_FILE"
            exit 1
        fi
        ;;
    stop)
        pid="$(read_pid)"
        if ! pid_alive "$pid"; then
            rm -f "$PID_FILE"
            echo "未在运行"
            exit 0
        fi
        kill -TERM "$pid" 2>/dev/null || true
        for _ in $(seq 1 30); do
            if ! pid_alive "$pid"; then
                rm -f "$PID_FILE"
                echo "已停止"
                exit 0
            fi
            sleep 0.5
        done
        echo "进程 $pid 未在 15 秒内退出；请检查日志" >&2
        exit 1
        ;;
    restart)
        "$0" stop || true
        "$0" start
        ;;
    logs)
        ensure_home
        tail -n 100 -f "$BOT_HOME/logs/bridge.log"
        ;;
    ""|-h|--help|help)
        usage
        ;;
    *)
        echo "未知命令: $1" >&2
        usage
        exit 2
        ;;
esac
