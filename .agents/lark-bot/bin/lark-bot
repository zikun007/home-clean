#!/usr/bin/env bash
# lark-bot 运行控制脚本
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    SOURCE_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    case "$SOURCE" in
        /*) ;;
        *) SOURCE="$SOURCE_DIR/$SOURCE" ;;
    esac
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
BOT_SRC="$(cd "$SCRIPT_DIR/.." && pwd)"
# 同一份源码跑两个实例：按被调用的名字推断默认值，避免 omp-lark-bot
# 误用 lark-bot 的 home / launchd 标签（会去停掉另一个实例）
INVOKED="$(basename -- "${0:-lark-bot}")"
case "$INVOKED" in
    omp-lark-bot) DEFAULT_BOT_HOME="$HOME/.omp/lark-bot"; DEFAULT_SERVICE="omp-lark-bot" ;;
    *)            DEFAULT_BOT_HOME="$HOME/.agents/lark-bot"; DEFAULT_SERVICE="lark-bot" ;;
esac
BOT_HOME="${LARK_BOT_HOME:-$DEFAULT_BOT_HOME}"
SERVICE_NAME="${LARK_BOT_SERVICE:-$DEFAULT_SERVICE}"
# macOS 上的 launchd 标签；setup.sh 安装时写入，手动起同名标签也可
LAUNCHD_LABEL="${LARK_BOT_LAUNCHD_LABEL:-com.home-clean.$SERVICE_NAME}"
PYTHON_BIN="${PYTHON_BIN:-python3}"
PID_FILE="$BOT_HOME/bridge.pid"
CONFIG_FILE="$BOT_HOME/config.env"

# 该实例是否由 launchd 托管（macOS）
launchd_loaded() {
    command -v launchctl >/dev/null 2>&1 || return 1
    launchctl print "gui/$UID/$LAUNCHD_LABEL" >/dev/null 2>&1
}

usage() {
    cat <<'USAGE'
用法: lark-bot <command>

  run [--no-console]   前台运行
  start                后台启动（Linux: setsid / macOS: nohup）
  stop                 停止后台进程（launchd 托管时同时卸载）
  restart              重启（launchd 托管时用 kickstart）
  status               查看任务/队列/进程状态
  check                检查配置、二进制和飞书鉴权
  logs                 跟踪日志

macOS 上由 setup.sh 安装 LaunchAgent（com.home-clean.lark-bot），登录自启、
崩溃自动重启；标签可用 LARK_BOT_LAUNCHD_LABEL 覆盖。
USAGE
}

ensure_home() {
    mkdir -p "$BOT_HOME/logs" "$BOT_HOME/memory"
    if [ ! -f "$CONFIG_FILE" ]; then
        echo "缺少配置: $CONFIG_FILE" >&2
        echo "请先复制 $BOT_SRC/config.example.env 并填写 OWNER_ID" >&2
        exit 1
    fi
    chmod 600 "$CONFIG_FILE" 2>/dev/null || true
}

pid_alive() {
    local pid="${1:-}"
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

read_pid() {
    [ -f "$PID_FILE" ] && cat "$PID_FILE" 2>/dev/null || true
}

case "${1:-}" in
    run)
        shift
        ensure_home
        exec "$PYTHON_BIN" "$BOT_SRC/bridge.py" --home "$BOT_HOME" run "$@"
        ;;
    check)
        ensure_home
        exec "$PYTHON_BIN" "$BOT_SRC/bridge.py" --home "$BOT_HOME" check
        ;;
    status)
        ensure_home
        exec "$PYTHON_BIN" "$BOT_SRC/bridge.py" --home "$BOT_HOME" status
        ;;
    start)
        ensure_home
        if command -v systemctl >/dev/null 2>&1 && systemctl --user is-active --quiet "$SERVICE_NAME" 2>/dev/null; then
            echo "systemd 服务 $SERVICE_NAME 已在运行；请使用 systemctl --user restart $SERVICE_NAME" >&2
            exit 1
        fi
        if launchd_loaded; then
            echo "launchd 已托管 $LAUNCHD_LABEL；请使用 launchctl kickstart -k gui/$UID/$LAUNCHD_LABEL 重启" >&2
            exit 1
        fi
        pid="$(read_pid)"
        if pid_alive "$pid"; then
            echo "已在运行 (pid=$pid)"
            exit 0
        fi
        # Linux 有 setsid，可脱离当前会话；macOS 没有 setsid，用 nohup 直接后台
        if command -v setsid >/dev/null 2>&1; then
            nohup setsid "$PYTHON_BIN" "$BOT_SRC/bridge.py" --home "$BOT_HOME" run --no-console \
                >>"$BOT_HOME/logs/daemon.log" 2>&1 </dev/null &
        else
            nohup "$PYTHON_BIN" "$BOT_SRC/bridge.py" --home "$BOT_HOME" run --no-console \
                >>"$BOT_HOME/logs/daemon.log" 2>&1 </dev/null &
        fi
        echo $! > "$PID_FILE"
        sleep 1
        if pid_alive "$(read_pid)"; then
            echo "已启动 (pid=$(read_pid))"
            echo "日志: $BOT_HOME/logs/bridge.log"
        else
            echo "启动失败，最近日志：" >&2
            tail -n 30 "$BOT_HOME/logs/daemon.log" >&2 || true
            rm -f "$PID_FILE"
            exit 1
        fi
        ;;
    stop)
        # launchd 托管时先卸载，否则 KeepAlive 会把进程立刻拉回来
        if launchd_loaded; then
            launchctl bootout "gui/$UID/$LAUNCHD_LABEL" 2>/dev/null || true
            rm -f "$PID_FILE"
            echo "已停止（并卸载 launchd 托管；重新登录不会再自启）"
            exit 0
        fi
        pid="$(read_pid)"
        if ! pid_alive "$pid"; then
            rm -f "$PID_FILE"
            echo "未在运行"
            exit 0
        fi
        kill -TERM "$pid" 2>/dev/null || true
        for _ in $(seq 1 30); do
            if ! pid_alive "$pid"; then
                rm -f "$PID_FILE"
                echo "已停止"
                exit 0
            fi
            sleep 0.5
        done
        echo "进程 $pid 未在 15 秒内退出；请检查日志" >&2
        exit 1
        ;;
    restart)
        if launchd_loaded; then
            launchctl kickstart -k "gui/$UID/$LAUNCHD_LABEL"
            echo "已通过 launchd 重启 $LAUNCHD_LABEL"
            exit 0
        fi
        "$0" stop || true
        "$0" start
        ;;
    logs)
        ensure_home
        tail -n 100 -f "$BOT_HOME/logs/bridge.log"
        ;;
    ""|-h|--help|help)
        usage
        ;;
    *)
        echo "未知命令: $1" >&2
        usage
        exit 2
        ;;
esac
