[Unit]
Description=Feishu Lark bot (Codex bridge)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.agents/lark-bot
EnvironmentFile=%h/.agents/lark-bot/config.env
Environment=PYTHONUNBUFFERED=1
Environment="PATH=%h/.local/bin:%h/.config/nvm/versions/node/v24.21.0/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=%h/.local/bin/lark-bot run --no-console
Restart=always
RestartSec=5
KillMode=mixed
TimeoutStopSec=20

[Install]
WantedBy=default.target
