[Unit]
Description=claude-lark-bot: Feishu <-> Claude Code bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.claude/lark-bot
Environment=PYTHONUNBUFFERED=1
Environment=HOME=%h
Environment=LARK_BOT_HOME=%h/.claude/lark-bot
Environment=LARK_BOT_SERVICE=claude-lark-bot
Environment="PATH=%h/.local/bin:%h/.config/nvm/versions/node/v24.21.0/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=%h/.local/bin/claude-lark-bot run --no-console
Restart=always
RestartSec=5
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=default.target
