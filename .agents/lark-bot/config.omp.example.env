# lark-bot 运行时配置模板（omp 版本）
# 复制到 ~/.omp/lark-bot/config.env 并 chmod 600。
# 该文件含个人 open_id，不要提交到仓库。

# 主人 open_id（local-omp 这个飞书 app 下的 open_id）
OWNER_ID=ou_xxxxxxxxxxxxxxxx

# omp 工作区
WORKDIR=/home/horizon/workspace

# 助手类型与可执行文件
AGENT_KIND=omp
AGENT_BIN=/home/horizon/.local/bin/omp

# 模型留空则使用 omp 默认配置
AGENT_MODEL=

# lark-cli 与 profile（local-omp 对应的 profile）
LARK_CLI_BIN=lark-cli
LARK_PROFILE=omp-bot

# 并发任务数
MAX_CONCURRENCY=1

# 单任务超时（秒）
TASK_TIMEOUT=1800

# 群聊：off | owner | mention | all
GROUP_MODE=off
BOT_OPEN_ID=
ALLOWED_CHATS=

# 会话粒度：chat | thread
SESSION_SCOPE=chat

# 进度消息按批合并
PROGRESS=1
PROGRESS_BATCH_ITEMS=10
PROGRESS_BATCH_SECONDS=60

# markdown | text
REPLY_FORMAT=markdown
MAX_REPLY_BYTES=3500

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
