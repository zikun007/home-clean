# lark-bot 运行时配置模板（omp 版本）
# 复制到 ~/.omp/lark-bot/config.env 并 chmod 600。
# 该文件含个人 open_id，不要提交到仓库。

# 主人 open_id（omp 这个飞书 app 下的 open_id）
OWNER_ID=ou_xxxxxxxxxxxxxxxx

# omp 工作区（支持 ~ 展开；留空则默认 ~/workspace）
WORKDIR=~/Workspace

# 助手类型与可执行文件（AGENT_BIN 留空时按 AGENT_KIND 选择 CODEX_BIN / OMP_BIN）
AGENT_KIND=omp
AGENT_BIN=
OMP_BIN=omp

# 模型留空则使用 omp 默认配置
AGENT_MODEL=

# lark-cli 与 profile（omp 对应的 profile）
LARK_CLI_BIN=lark-cli
LARK_PROFILE=omp

# 并发任务数
MAX_CONCURRENCY=1

# 单任务超时（秒）
TASK_TIMEOUT=7200

# 群聊：off | owner | mention | all
GROUP_MODE=off
BOT_OPEN_ID=
ALLOWED_CHATS=

# 会话粒度：chat | thread
SESSION_SCOPE=chat

# 进度消息按批合并
PROGRESS=1
PROGRESS_BATCH_ITEMS=10
PROGRESS_BATCH_SECONDS=60
QUIET=0
# 监听卡片按钮事件；未订阅 card.action.trigger 时仍可用 /answer
CARD_ACTIONS=1

# markdown | text
REPLY_FORMAT=markdown
MAX_REPLY_BYTES=3500

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# 论文推送（所有 lark-bot 实例共用同一份 PAPER_HOME，避免重复推送）
# ---------------------------------------------------------------------------
PAPER_HOME=~/.agents/papers
PAPER_ENABLED_DEFAULT=0
PAPER_TOPICS_FILE=
PAPER_PUSH_TIME=08:30
PAPER_TIMEZONE=
PAPER_MIN=4
PAPER_MAX=8
PAPER_LOOKBACK_HOURS=96
PAPER_MAX_RESULTS_PER_CATEGORY=50
PAPER_CATEGORY_LIMIT=3
PAPER_MAX_ATTACH=3
# 该 profile 需要有已登录用户，才能把笔记放进主人的云文档
PAPER_DOC_PROFILE=omp
PAPER_DOC_FOLDER=
PAPER_NOTE_UPLOAD=1
PAPER_S2_API_KEY=
PAPER_HF_ENABLED=0
