# codex-lark-bot 运行时配置模板（Codex 版）
# 复制到 ~/.codex/lark-bot/config.env 并 chmod 600
# 该文件含个人 open_id，不要提交到仓库。

# 主人 open_id（只响应这个人）
OWNER_ID=ou_xxxxxxxxxxxxxxxx

# 助手类型：codex | omp | claude
AGENT_KIND=codex

# 助手工作区（支持 ~ 展开；留空则默认 ~/workspace）
WORKDIR=~/Workspace

# 模型留空则使用助手默认配置
AGENT_MODEL=

# 可执行文件；AGENT_BIN 留空时按 AGENT_KIND 选择 CODEX_BIN / OMP_BIN / CLAUDE_BIN
AGENT_BIN=
CODEX_BIN=codex
OMP_BIN=omp
CLAUDE_BIN=claude
LARK_CLI_BIN=lark-cli

# Claude 权限模式（仅 AGENT_KIND=claude）：acceptEdits | auto |
# bypassPermissions | manual | dontAsk | plan
# 非交互机器人需要联网和读写，推荐 bypassPermissions。
CLAUDE_PERMISSION_MODE=bypassPermissions

# lark-cli 身份 profile；每个实例绑定自己的飞书 app
LARK_PROFILE=codex

# 沙箱（仅 Codex 使用）：read-only | workspace-write | danger-full-access
SANDBOX=workspace-write

# 并发任务数；默认 1，避免同时启动多个助手进程
MAX_CONCURRENCY=1

# 单任务超时（秒）
TASK_TIMEOUT=7200

# 群聊：off | owner | mention | all
# off=只用私聊；owner=群里只响应主人；mention=群里必须 @机器人；all=群里所有人
GROUP_MODE=off

# GROUP_MODE=mention 时必填机器人 open_id
BOT_OPEN_ID=

# 群聊白名单，逗号分隔 oc_xxx；留空表示不限制
ALLOWED_CHATS=

# 会话粒度：chat=每个会话一个 thread；thread=每个话题一个 thread
SESSION_SCOPE=chat

# 是否发送执行进度（按批合并，避免每条命令一条消息）
PROGRESS=1
# 一批最多包含多少条命令/文件变更；达到即发送
PROGRESS_BATCH_ITEMS=10
# 距离上一批超过多少秒时发送；任务结束时会强制发送最后一批
PROGRESS_BATCH_SECONDS=60
QUIET=0
# 监听卡片按钮事件；未订阅 card.action.trigger 时仍可用 /answer
CARD_ACTIONS=1

# markdown | text
REPLY_FORMAT=markdown

# 单条飞书消息最大字节数（超过自动分片）
MAX_REPLY_BYTES=3500

# 只有显式设为 1 才允许 SANDBOX=danger-full-access
ALLOW_DANGER=0

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# 论文推送（所有 lark-bot 实例共用同一份 PAPER_HOME，避免重复推送）
# ---------------------------------------------------------------------------
# 共享论文库：papers.db / topics.json / library / digests / notes
PAPER_HOME=~/.agents/papers
# 默认关闭每日推送；发 /paper-start 启用，/paper-stop 关闭
PAPER_ENABLED_DEFAULT=0
# 关注方向；留空则使用 PAPER_HOME/topics.json，首次启动自动生成
PAPER_TOPICS_FILE=

# 每天推送时间（本地时区，HH:MM）；启动晚了会当天补发
PAPER_PUSH_TIME=08:30
# 可选 IANA 时区，例如 Asia/Shanghai；留空用系统时区
PAPER_TIMEZONE=
# 每天最终推送篇数范围
PAPER_MIN=4
PAPER_MAX=8
# 抓取最近多少小时的新论文
PAPER_LOOKBACK_HOURS=96
# 每个 arXiv 分类最多抓多少条
PAPER_MAX_RESULTS_PER_CATEGORY=50
# 候选里每个主分类最多保留几篇（最终篇数由 PAPER_MIN/MAX 控制）
PAPER_CATEGORY_LIMIT=3
# 单条消息最多预取几篇论文全文
PAPER_MAX_ATTACH=3

# 飞书文档创建：需要 --as user，因此 profile 必须有已登录用户。
# 例如 omp 有用户授权；codex 目前没有。
PAPER_DOC_PROFILE=omp
# 可选：放到指定云文档文件夹或知识库节点；留空则放到“我的空间”
# 这里填知识库父节点 token（或完整 wiki URL），每日速递会作为日期子文档建在它下面
PAPER_DOC_FOLDER=
PAPER_NOTE_UPLOAD=1

# 可选数据源（见 docs/paper-sources.md）
PAPER_S2_API_KEY=
PAPER_HF_ENABLED=0
